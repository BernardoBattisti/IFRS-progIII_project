# Copie para .env e ajuste:  cp .env.example .env

# Banco
POSTGRES_DB=votacoes
POSTGRES_USER=votacoes
POSTGRES_PASSWORD=troque-esta-senha

# Segredo do JWT e do HMAC de anonimato (mínimo 32 caracteres). Gere com: openssl rand -base64 48
APP_JWT_SECRET=

# URL pública do sistema (a do frontend)
APP_BASE_URL=http://localhost:3000

# Google OAuth: console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth ("Aplicativo da Web")
# URI de redirecionamento autorizado: http://localhost:3000/api/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domínios de e-mail aceitos, separados por vírgula (vazio = qualquer conta Google)
APP_ALLOWED_DOMAINS=

# E-mails que entram como administradores, separados por vírgula
APP_ADMIN_EMAILS=

# "dev" habilita o login de desenvolvimento (sem Google). NUNCA use em produção.
SPRING_PROFILES_ACTIVE=dev
