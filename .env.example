# Copie para .env e ajuste:  cp .env.example .env

# Banco
POSTGRES_DB=votacoes
POSTGRES_USER=votacoes
POSTGRES_PASSWORD=troque-esta-senha

# Segredo do JWT e do HMAC de anonimato (mínimo 32 caracteres). Gere com: openssl rand -base64 48
APP_JWT_SECRET=

# URL pública do sistema (a do frontend). Usada no link do e-mail de redefinição de senha.
APP_BASE_URL=http://localhost:3000

# E-mail (recuperação de senha).
# Deixe tudo vazio para usar o Mailpit do Docker Compose: os e-mails aparecem em http://localhost:8025
# e nenhum sai de verdade.
# Para enviar de verdade pelo Gmail: crie uma "senha de app" na conta Google e preencha, por exemplo:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=sua-conta@gmail.com
#   MAIL_PASSWORD=senha-de-app-de-16-letras
#   MAIL_STARTTLS=true
#   MAIL_FROM=sua-conta@gmail.com
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=
MAIL_FROM=

# O administrador é fixo: adm@gmail.com / admin (criado automaticamente).
# Os domínios de e-mail aceitos são configurados na página do administrador.
